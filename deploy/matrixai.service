[Unit]
Description=MatrixAI fleet control center
Documentation=https://github.com/OWNER/matrixai
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=matrixai
Group=matrixai
WorkingDirectory=/opt/matrixai/server
Environment=NODE_ENV=production
EnvironmentFile=-/etc/matrixai/matrixai.env
ExecStart=/usr/bin/node src/index.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=25
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/matrixai
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
