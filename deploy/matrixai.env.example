# MatrixAI — configuration de production
HOST=0.0.0.0
PORT=3000
NODE_ENV=production
LOG_LEVEL=info

# État mutable hors du code
MATRIXAI_DATA_DIR=/var/lib/matrixai
MATRIXAI_WEB_DIST=/opt/matrixai/web/dist

# Réseau à scanner (limité à un /24 dans cette version)
MATRIXAI_LAN=192.168.1.0/24
COLLECT_INTERVAL_MS=5000
HISTORY_RAW_HOURS=24

# Définir à 1 uniquement derrière un reverse proxy de confiance (Caddy, Tailscale Serve…)
MATRIXAI_TRUST_PROXY=1

# Optionnel au premier lancement. Sans ces variables, un mot de passe aléatoire
# est écrit dans /var/lib/matrixai/bootstrap-credentials.txt (mode 0600).
# MATRIXAI_ADMIN_USER=admin
# MATRIXAI_ADMIN_PASSWORD=change-me-with-a-long-random-password

# Optionnel : secret explicite. Par défaut, généré dans /var/lib/matrixai/.secret.
# MATRIXAI_SECRET=replace-with-at-least-48-random-characters

# DANGEREUX : endpoint de shell SSH arbitraire, désactivé par défaut.
MATRIXAI_ENABLE_REMOTE_EXEC=0
